      "source": [
        "rooms = {\n",
        "    \"A\": \"Dirty\",\n",
        "    \"B\": \"Dirty\",\n",
        "    \"C\": \"Dirty\",\n",
        "    \"D\": \"Dirty\"\n",
        "}\n",
        "\n",
        "# Ask the user for the starting location\n",
        "while True:\n",
        "    start_location = input(\"Enter the starting room (A, B, C, or D): \").upper()\n",
        "    if start_location in rooms:\n",
        "        location = start_location\n",
        "        break\n",
        "    else:\n",
        "        print(\"Invalid room. Please enter A, B, C, or D.\")\n",
        "\n",
        "print(f\"Starting in Room: {location}\")\n",
        "\n",
        "while \"Dirty\" in rooms.values():\n",
        "\n",
        "    if rooms[location] == \"Dirty\":\n",
        "        print(\"Sucking dirt in Room\", location)\n",
        "        rooms[location] = \"Clean\"\n",
        "\n",
        "    elif location == \"A\":\n",
        "        print(\"Moving Right: A -> B\")\n",
        "        location = \"B\"\n",
        "\n",
        "    elif location == \"B\":\n",
        "        print(\"Moving Down: B -> C\")\n",
        "        location = \"C\"\n",
        "\n",
        "    elif location == \"C\":\n",
        "        print(\"Moving Left: C -> D\")\n",
        "        location = \"D\"\n",
        "\n",
        "    elif location == \"D\":\n",
        "        print(\"Moving Up: D -> A\")\n",
        "        location = \"A\"\n",
        "\n",
        "print(\"All rooms are clean!\")"
      ]
