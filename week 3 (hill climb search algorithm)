    {
      "cell_type": "code",
      "source": [
        "N = 4\n",
        "\n",
        "def calculate_heuristic(state):\n",
        "    attacks = 0\n",
        "    for i in range(N):\n",
        "        for j in range(i + 1, N):\n",
        "            if state[i] == state[j]:\n",
        "                attacks += 1\n",
        "            if abs(state[i] - state[j]) == abs(i - j):\n",
        "                attacks += 1\n",
        "    return attacks\n",
        "\n",
        "def get_best_neighbor(state, allow_sideways=True):\n",
        "    current_h = calculate_heuristic(state)\n",
        "    best_h = current_h\n",
        "    best_neighbors = []\n",
        "\n",
        "    for col in range(N):\n",
        "        original_row = state[col]\n",
        "        for row in range(N):\n",
        "            if row == original_row:\n",
        "                continue\n",
        "\n",
        "            neighbor = list(state)\n",
        "            neighbor[col] = row\n",
        "            neighbor_h = calculate_heuristic(neighbor)\n",
        "\n",
        "            if neighbor_h < best_h:\n",
        "                best_h = neighbor_h\n",
        "                best_neighbors = [neighbor]\n",
        "            elif neighbor_h == best_h and allow_sideways:\n",
        "                best_neighbors.append(neighbor)\n",
        "\n",
        "    if best_h < current_h:\n",
        "        return best_neighbors[0], best_h, False\n",
        "    elif best_h == current_h and best_neighbors:\n",
        "        import random\n",
        "        return random.choice(best_neighbors), best_h, True\n",
        "    return None, current_h, False\n",
        "\n",
        "def print_board(state):\n",
        "    for row in range(N):\n",
        "        line = \"\"\n",
        "        for col in range(N):\n",
        "            if state[col] == row:\n",
        "                line += \" Q \"\n",
        "            else:\n",
        "                line += \" . \"\n",
        "        print(line)\n",
        "    print()\n",
        "\n",
        "def main():\n",
        "    print(\"--- 4-Queens Hill Climbing (with Sideways Moves) ---\")\n",
        "    print(\"Enter the initial row position (0 to 3) for each queen column by column.\")\n",
        "\n",
        "    current_state = []\n",
        "    for i in range(N):\n",
        "        while True:\n",
        "            try:\n",
        "                row = int(input(f\"Enter row index for Queen in Column {i} (0-3): \"))\n",
        "                if 0 <= row < N:\n",
        "                    current_state.append(row)\n",
        "                    break\n",
        "                else:\n",
        "                    print(\"Invalid input. Must be between 0 and 3.\")\n",
        "            except ValueError:\n",
        "                print(\"Please enter a valid integer.\")\n",
        "\n",
        "    current_h = calculate_heuristic(current_state)\n",
        "    step = 0\n",
        "    sideways_count = 0\n",
        "    max_sideways = 100\n",
        "\n",
        "    print(\"\\n================ STARTING SEARCH ================\")\n",
        "    print(f\"Step {step} | State: {current_state} | Heuristic h = {current_h}\")\n",
        "    print_board(current_state)\n",
        "\n",
        "    while True:\n",
        "        if current_h == 0:\n",
        "            print(\"Success! Found a valid solution.\")\n",
        "            break\n",
        "\n",
        "        neighbor, neighbor_h, is_sideways = get_best_neighbor(current_state, allow_sideways=True)\n",
        "\n",
        "        if neighbor is None:\n",
        "            print(f\"Stuck at local minimum (h = {current_h}).\")\n",
        "            break\n",
        "\n",
        "        if is_sideways:\n",
        "            sideways_count += 1\n",
        "            if sideways_count > max_sideways:\n",
        "                print(f\"Stuck on a plateau: reached limit of {max_sideways} sideways moves.\")\n",
        "                break\n",
        "        else:\n",
        "            sideways_count = 0\n",
        "\n",
        "        step += 1\n",
        "        current_state = neighbor\n",
        "        current_h = neighbor_h\n",
        "\n",
        "        move_type = \"Sideways Move\" if is_sideways else \"Better Neighbor\"\n",
        "        print(f\"Step {step} | {move_type} to State: {current_state} | Heuristic h = {current_h}\")\n",
        "        print_board(current_state)\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ],
